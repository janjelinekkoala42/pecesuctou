---
interface Props {
	light?: boolean;
}

const { light = false } = Astro.props;
---

<a href="/" class:list={['logo', { light }]} aria-label="Péče s úctou – úvod">
	<svg viewBox="0 0 24 28" width="22" height="26" aria-hidden="true">
		<path d="M3 27V11a9 9 0 0 1 18 0v16Z" fill="none" stroke="currentColor" stroke-width="1.3" />
		<path d="M12 23v-9M12 17c-3 0-4.5-2-4.5-4.5 2.5 0 4.5 1.5 4.5 4.5ZM12 15c0-3 2-4.5 4.5-4.5 0 2.5-2 4.5-4.5 4.5Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
	</svg>
	<span>Péče <em>s úctou</em></span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--green);
		font-family: var(--serif);
		font-size: 1.6rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.logo.light {
		color: #fff;
	}

	em {
		font-style: italic;
	}
</style>

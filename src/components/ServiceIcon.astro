---
// Piktogramy služeb ve stylu loga: tenká zelená linka, zlatý akcent.
interface Props {
	name: 'broom' | 'calendar' | 'cycle' | 'bouquet';
	size?: number;
}

const { name, size = 72 } = Astro.props;
---

<svg
	class="service-icon"
	viewBox="0 0 48 48"
	width={size}
	height={size}
	aria-hidden="true"
	fill="none"
	stroke="currentColor"
	stroke-width="1.4"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	{
		name === 'broom' && (
			<g transform="rotate(-18 24 26)">
				<path d="M24 3v19" />
				<rect x="18" y="22" width="12" height="5" rx="1.5" />
				<path d="M18 27 13 45h22l-5-18" />
				<path d="M21 31l-2.5 14M24 31v14M27 31l2.5 14" />
				<path class="accent" d="M18 24.5h12" />
			</g>
		)
	}
	{
		name === 'calendar' && (
			<>
				<rect x="7" y="10" width="34" height="31" rx="3" />
				<path d="M7 18h34M16 6v8M32 6v8" />
				<g class="dots">
					<circle cx="14" cy="25" r="0.9" />
					<circle cx="24" cy="25" r="0.9" />
					<circle cx="34" cy="25" r="0.9" />
					<circle cx="24" cy="34" r="0.9" />
				</g>
				<circle class="accent fill" cx="14" cy="34" r="3" />
				<circle class="accent fill" cx="34" cy="34" r="3" />
			</>
		)
	}
	{
		name === 'cycle' && (
			<>
				<path d="M38.5 17A16 16 0 0 0 11 13" />
				<path d="M9.5 31A16 16 0 0 0 37 35" />
				<path d="M11 13l.2-5.2M11 13l5.1.8M37 35l-.2 5.2M37 35l-5.1-.8" />
				<circle class="accent fill" cx="24" cy="8" r="2.4" />
				<circle class="accent fill" cx="40" cy="24" r="2.4" />
				<circle class="accent fill" cx="24" cy="40" r="2.4" />
				<circle class="accent fill" cx="8" cy="24" r="2.4" />
				<path d="M24 29v-9M24 23c-2.6 0-4-1.6-4-3.8 2.2 0 4 1.3 4 3.8ZM24 21.5c0-2.6 1.6-3.9 3.8-3.9 0 2.2-1.6 3.9-3.8 3.9Z" />
			</>
		)
	}
	{
		name === 'bouquet' && (
			<>
				<path d="M24 43 17 23M24 43V19M24 43l7-20" />
				<circle cx="16" cy="18.5" r="4.5" />
				<circle cx="24" cy="13" r="4.5" />
				<circle cx="32" cy="18.5" r="4.5" />
				<circle class="accent fill" cx="16" cy="18.5" r="1.3" />
				<circle class="accent fill" cx="24" cy="13" r="1.3" />
				<circle class="accent fill" cx="32" cy="18.5" r="1.3" />
				<path d="M20.5 30c-3-.2-5.5-2-6.5-4.5 3 .1 5.5 1.7 6.5 4.5ZM27.5 30c3-.2 5.5-2 6.5-4.5-3 .1-5.5 1.7-6.5 4.5Z" />
				<path class="accent" d="M24 36.5c-2.5-2.3-5-1.8-5 0s2.5 2.3 5 0Zm0 0c2.5-2.3 5-1.8 5 0s-2.5 2.3-5 0Z" />
			</>
		)
	}
</svg>

<style>
	.service-icon {
		color: var(--green);
	}

	.accent {
		stroke: var(--gold);
	}

	.fill {
		fill: var(--gold);
	}

	.dots circle {
		fill: currentColor;
		stroke: none;
		opacity: 0.45;
	}
</style>

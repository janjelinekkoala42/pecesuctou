---
import { beforeAfter, testimonials } from '../data/content';
---

<section class="section" id="reference">
	<div class="wrap">
		<p class="eyebrow">Reference</p>
		<h2>Péče, kterou můžete vidět</h2>
		<p class="lead">
			Ukázky naší práce a situace, se kterými se na nás lidé obracejí. Fotografie zveřejňujeme jen se souhlasem
			rodiny.
		</p>

		<div class="grid">
			{
				beforeAfter.map((caption) => (
					<figure>
						<div class="pair">
							<div class="before">Před</div>
							<div class="after">Po</div>
						</div>
						<figcaption>{caption}</figcaption>
					</figure>
				))
			}
		</div>

		<div class="grid quotes">
			{
				testimonials.map((t) => (
					<blockquote>
						<span class="mark">”</span>
						<p>„{t.text}“</p>
						<footer>
							{t.name && <><strong>{t.name}</strong> · </>}
							{t.meta}
						</footer>
					</blockquote>
				))
			}
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin-top: 3rem;
	}

	figure {
		margin: 0;
	}

	.pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3px;
		aspect-ratio: 16 / 10;
	}

	.pair div {
		display: flex;
		align-items: flex-end;
		padding: 0.75rem;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--green);
	}

	.before {
		background: var(--sand);
	}

	.after {
		background: var(--sage);
	}

	figcaption {
		margin-top: 0.6rem;
		font-size: 0.8rem;
		color: var(--muted);
	}

	blockquote {
		margin: 0;
		padding: 2rem;
		border: 1px solid var(--line);
		background: var(--cream-light);
	}

	.mark {
		display: block;
		height: 1.5rem;
		color: var(--gold);
		font-family: var(--serif);
		font-size: 2.5rem;
		line-height: 1;
	}

	blockquote p {
		font-family: var(--serif);
		font-size: 1.35rem;
		font-style: italic;
		line-height: 1.35;
		color: var(--green);
	}

	blockquote footer {
		margin-top: 1rem;
		font-size: 0.8rem;
		color: var(--muted);
	}

	blockquote strong {
		color: var(--text);
	}

	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>

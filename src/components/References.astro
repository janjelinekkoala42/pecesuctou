---
import { Image } from 'astro:assets';
import { beforeAfter, decorations, testimonials } from '../data/content';
---

<section class="section" id="reference">
	<div class="wrap">
		<p class="eyebrow">Reference</p>
		<h2>Péče, kterou můžete vidět</h2>
		<p class="lead">
			Ukázky naší práce a situace, se kterými se na nás lidé obracejí. Fotografie zveřejňujeme jen se souhlasem
			rodiny.
		</p>

		<div class="pairs">
			{
				beforeAfter.map((item) => (
					<figure>
						<div class="pair">
							<div class="half">
								<Image src={item.before} alt={`Před: ${item.caption}`} widths={[320, 640]} sizes="(max-width: 860px) 50vw, 300px" />
								<span>Před</span>
							</div>
							<div class="half">
								<Image src={item.after} alt={`Po: ${item.caption}`} widths={[320, 640]} sizes="(max-width: 860px) 50vw, 300px" />
								<span class="after">Po</span>
							</div>
						</div>
						<figcaption>{item.caption}</figcaption>
					</figure>
				))
			}
		</div>

		<div class="gallery">
			{
				decorations.map((item) => (
					<figure>
						<Image src={item.photo} alt={item.alt} widths={[400, 800]} sizes="(max-width: 860px) 100vw, 600px" />
						<figcaption>{item.caption}</figcaption>
					</figure>
				))
			}
		</div>

		<div class="grid quotes">
			{
				testimonials.map((t) => (
					<blockquote>
						<span class="mark">”</span>
						<p>„{t.text}“</p>
						<footer>
							{t.name && <><strong>{t.name}</strong> · </>}
							{t.meta}
						</footer>
					</blockquote>
				))
			}
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin-top: 3rem;
	}

	figure {
		margin: 0;
	}

	.pairs,
	.gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem 1.5rem;
		margin-top: 3rem;
	}

	.gallery {
		grid-template-columns: repeat(auto-fit, minmax(16rem, 26rem));
		justify-content: center;
	}

	.pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3px;
		aspect-ratio: 1 / 1;
	}

	.half {
		position: relative;
		overflow: hidden;
		background: var(--sand);
	}

	.half img,
	.gallery img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.half span {
		position: absolute;
		left: 0.6rem;
		bottom: 0.6rem;
		padding: 0.3rem 0.6rem;
		background: rgb(243 238 231 / 0.92);
		color: var(--green);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.half span.after {
		background: var(--green);
		color: #fff;
	}

	.gallery img {
		aspect-ratio: 4 / 5;
		height: auto;
	}

	figcaption {
		margin-top: 0.6rem;
		font-size: 0.8rem;
		color: var(--muted);
	}

	blockquote {
		margin: 0;
		padding: 2rem;
		border: 1px solid var(--line);
		background: var(--cream-light);
	}

	.mark {
		display: block;
		height: 1.5rem;
		color: var(--gold);
		font-family: var(--serif);
		font-size: 2.5rem;
		line-height: 1;
	}

	blockquote p {
		font-family: var(--serif);
		font-size: 1.35rem;
		font-style: italic;
		line-height: 1.35;
		color: var(--green);
	}

	blockquote footer {
		margin-top: 1rem;
		font-size: 0.8rem;
		color: var(--muted);
	}

	blockquote strong {
		color: var(--text);
	}

	@media (max-width: 860px) {
		.grid,
		.pairs {
			grid-template-columns: 1fr;
		}

		.gallery {
			gap: 1rem;
		}
	}
</style>

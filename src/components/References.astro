---
import { Image } from 'astro:assets';
import { beforeAfter, decorations, testimonials } from '../data/content';
---

<section class="section" id="reference">
	<div class="wrap">
		<p class="eyebrow">Reference</p>
		<h2>Péče, kterou můžete vidět</h2>
		<p class="lead">
			Ukázky naší práce a situace, se kterými se na nás lidé obracejí. Fotografie zveřejňujeme jen se souhlasem
			rodiny.
		</p>

		<div class="pairs">
			{
				beforeAfter.map((item) => (
					<figure>
						<div class="shot">
							<Image
								src={item.photo}
								alt={`Před a po péči: ${item.caption}`}
								widths={[400, 700, 1100]}
								sizes="(max-width: 860px) 100vw, 560px"
							/>
							{item.labels && (
								<>
									<span class="label before">Před péčí</span>
									<span class="label after">Po péči</span>
								</>
							)}
						</div>
						<figcaption>{item.caption}</figcaption>
					</figure>
				))
			}
		</div>

		<div class="gallery">
			{
				decorations.map((item) => (
					<figure>
						<Image src={item.photo} alt={item.alt} widths={[400, 800]} sizes="(max-width: 860px) 100vw, 600px" />
						<figcaption>{item.caption}</figcaption>
					</figure>
				))
			}
		</div>

		<div class="grid quotes">
			{
				testimonials.map((t) => (
					<blockquote>
						<span class="mark">”</span>
						<p>„{t.text}“</p>
						<footer>
							{t.name && <><strong>{t.name}</strong> · </>}
							{t.meta}
						</footer>
					</blockquote>
				))
			}
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin-top: 3rem;
	}

	figure {
		margin: 0;
	}

	.pairs,
	.gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem 1.5rem;
		margin-top: 3rem;
	}

	.gallery {
		grid-template-columns: repeat(auto-fit, minmax(16rem, 26rem));
		justify-content: center;
	}

	.pairs {
		align-items: start;
	}

	.shot {
		position: relative;
	}

	.shot img,
	.gallery img {
		width: 100%;
		height: auto;
		display: block;
	}

	.label {
		position: absolute;
		bottom: 4%;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		background: rgb(243 238 231 / 0.94);
		color: var(--text);
		font-size: 0.85rem;
		transform: translateX(-50%);
	}

	.label.before {
		left: 25%;
	}

	.label.after {
		left: 75%;
	}

	.gallery img {
		object-fit: cover;
	}

	.gallery img {
		aspect-ratio: 4 / 5;
	}

	figcaption {
		margin-top: 0.6rem;
		font-size: 0.8rem;
		color: var(--muted);
	}

	blockquote {
		margin: 0;
		padding: 2rem;
		border: 1px solid var(--line);
		background: var(--cream-light);
	}

	.mark {
		display: block;
		height: 1.5rem;
		color: var(--gold);
		font-family: var(--serif);
		font-size: 2.5rem;
		line-height: 1;
	}

	blockquote p {
		font-family: var(--serif);
		font-size: 1.35rem;
		font-style: italic;
		line-height: 1.35;
		color: var(--green);
	}

	blockquote footer {
		margin-top: 1rem;
		font-size: 0.8rem;
		color: var(--muted);
	}

	blockquote strong {
		color: var(--text);
	}

	@media (max-width: 860px) {
		.grid,
		.pairs {
			grid-template-columns: 1fr;
		}

		.gallery {
			gap: 1rem;
		}
	}
</style>

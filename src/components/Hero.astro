---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/work/uvod-vres-lucerna.jpg';

const trust = [
	{ icon: 'camera', text: 'Fotografie po každé návštěvě' },
	{ icon: 'candle', text: 'Zapálení svíčky a položení květiny v každém balíčku' },
	{ icon: 'check', text: 'Rozsah a cena domluvené předem' },
];
---

<section class="hero">
	<div class="wrap grid">
		<div>
			<p class="eyebrow">Péče o hroby v Praze a okolí</p>
			<h1>Vy vzpomínáte.<br /><em>My se postaráme.</em></h1>
			<p class="sub">O váš hrob se postaráme, i když vy nemůžete.</p>
			<p class="lead">
				Nemáte čas jezdit na hřbitov, bydlíte daleko nebo už pro vás není snadné starat se o hrob osobně?
				Postaráme se o úklid a údržbu hrobu, květiny i výzdobu na Dušičky a Vánoce – jednorázově i pravidelně
				během roku. S úctou a respektem k místu, které je pro vás důležité.
			</p>
			<div class="actions">
				<a class="btn" href="#sluzby">Vybrat péči o hrob</a>
				<a class="btn btn-outline" href="#kontakt">Nezávazně nás kontaktovat</a>
			</div>
		</div>
		<Image
			class="arch"
			src={heroPhoto}
			alt="Mísa s vřesem, břečťanem a šiškami se zapálenou svíčkou v lucerně na hrobě"
			widths={[480, 800, 1100]}
			sizes="(max-width: 860px) 100vw, 480px"
			loading="eager"
			fetchpriority="high"
		/>
	</div>
</section>

<div class="trust">
	<div class="wrap trust-inner">
		{
			trust.map((item) => (
				<div class="trust-item">
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
						{item.icon === 'camera' && (
							<>
								<path d="M3 8h4l2-3h6l2 3h4v11H3Z" />
								<circle cx="12" cy="13" r="3.5" />
							</>
						)}
						{item.icon === 'candle' && (
							<>
								<rect x="8.5" y="11" width="7" height="10.5" rx="1" />
								<path d="M12 11V8.5M12 2.5c1.9 2 1.7 4.6 0 5.6-1.7-1-1.9-3.6 0-5.6Z" />
							</>
						)}
						{item.icon === 'check' && <path d="m4 12 5 5L20 6" />}
					</svg>
					{item.text}
				</div>
			))
		}
	</div>
</div>

<style>
	.hero {
		padding: 4.5rem 0 4rem;
	}

	.grid {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 4rem;
		align-items: center;
	}

	h1 {
		font-size: clamp(3rem, 7vw, 4.75rem);
		line-height: 1.02;
	}

	h1 em {
		font-style: italic;
	}

	.sub {
		margin-top: 1.25rem;
		font-family: var(--serif);
		font-size: 1.6rem;
		line-height: 1.25;
		color: var(--green);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.arch {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		border-radius: 50% 50% 0 0 / 38% 38% 0 0;
		background: var(--green);
		object-fit: cover;
		object-position: 50% 60%;
	}

	.trust {
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: var(--cream-light);
	}

	.trust-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-top: 1.5rem;
		padding-bottom: 1.5rem;
	}

	.trust-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.95rem;
	}

	.trust-item svg {
		flex: none;
		color: var(--green);
	}

	@media (max-width: 860px) {
		.hero {
			padding-top: 3rem;
		}

		.grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.actions .btn {
			width: fit-content;
		}

		.trust-inner {
			flex-direction: column;
		}
	}
</style>
